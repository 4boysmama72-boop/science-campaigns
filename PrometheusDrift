// ============================================================
// STORAGE
// ============================================================
function save() {
  try {
    const toSave = { ...state, timerInterval:null, timerRunning:false, timerSeconds:0 };
    localStorage.setItem(STORAGE_KEY, JSON.stringify(toSave));
  } catch(e) { toast('Storage error: ' + e.message, 'error'); }
}

function load() {
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    if (!raw) return false;
    const parsed = JSON.parse(raw);
    state = { ...state, ...parsed, timerInterval:null, timerRunning:false, timerSeconds:0 };
    return true;
  } catch(e) { return false; }
}

// ============================================================
// SETUP
// ============================================================
function completeSetup() {
  const teacher = document.getElementById('setup-teacher').value.trim();
  if (!teacher) { toast('Please enter your name.', 'error'); return; }
  state.configured = true;
  state.teacher = teacher;
  state.classes[0].name = document.getElementById('setup-class1').value.trim() || 'Period 1';
  state.classes[1].name = document.getElementById('setup-class2').value.trim() || 'Period 3';
  state.classes[2].name = document.getElementById('setup-class3').value.trim() || 'Period 5';
  save();
  showHome();
}

function showSetup() {
  document.getElementById('setup-teacher').value = state.teacher || '';
  document.getElementById('setup-class1').value = state.classes[0].name;
  document.getElementById('setup-class2').value = state.classes[1].name;
  document.getElementById('setup-class3').value = state.classes[2].name;
  showScreen('screen-setup');
}

// ============================================================
// HOME
// ============================================================
function showHome() {
  state.activeClass = null;
  stopTimer();
  renderClassCards();
  updateSystemTime();
  showScreen('screen-home');
  document.getElementById('btn-launch').disabled = true;
  document.getElementById('btn-reveal').disabled = true;
}

function renderClassCards() {
  const grid = document.getElementById('class-grid');
  grid.innerHTML = '';
  state.classes.forEach((cls, i) => {
    const hasPending = !!cls.pendingDeltas;
    const branchClass = cls.failures >= 2 ? 'branch-critical' : cls.failures === 1 ? 'branch-caution' : (cls.day === 1 && cls.act === 1 && !hasPending) ? 'branch-new' : 'branch-nominal';
    const branchText = cls.failures >= 3 ? 'RESTRICTED' : cls.failures >= 2 ? 'CRITICAL' : cls.failures === 1 ? 'CAUTION' : hasPending ? 'REVEAL READY' : (cls.day === 1 && cls.act === 1) ? 'NOT STARTED' : 'NOMINAL';

    const card = document.createElement('div');
    card.className = 'class-card';
    card.id = `class-card-${i}`;
    card.onclick = () => selectClass(i);
    card.innerHTML = `
      <div class="class-period">Class ${i+1}</div>
      <div class="class-name">${cls.name}</div>
      <div class="class-status">Act ${cls.act} · Day ${cls.day} · Branch ${cls.branch}</div>
      ${hasPending ? `<div class="reveal-badge visible">⏳ Results pending — reveal next class</div>` : ''}
      <div class="class-branch ${branchClass}">${branchText}</div>
      <div class="mini-stats">
        <div class="mini-stat">
          <div class="mini-stat-label">⚡ Power</div>
          <div class="mini-stat-bar"><div class="mini-stat-fill" style="width:${cls.stats.power}%;background:#00c8ff"></div></div>
        </div>
        <div class="mini-stat">
          <div class="mini-stat-label">🛡 Hull</div>
          <div class="mini-stat-bar"><div class="mini-stat-fill" style="width:${cls.stats.hull}%;background:#00ff88"></div></div>
        </div>
        <div class="mini-stat">
          <div class="mini-stat-label">📡 Data</div>
          <div class="mini-stat-bar"><div class="mini-stat-fill" style="width:${cls.stats.data}%;background:#aa66ff"></div></div>
        </div>
        <div class="mini-stat">
          <div class="mini-stat-label">👥 Morale</div>
          <div class="mini-stat-bar"><div class="mini-stat-fill" style="width:${cls.stats.morale}%;background:#ffaa00"></div></div>
        </div>
      </div>
    `;
    grid.appendChild(card);
  });
}

function selectClass(i) {
  state.selectedHomeClass = i;
  document.querySelectorAll('.class-card').forEach((c,idx) => c.classList.toggle('selected', idx === i));
  document.getElementById('btn-launch').disabled = false;
  const hasPending = !!state.classes[i].pendingDeltas;
  document.getElementById('btn-reveal').disabled = !hasPending;
}

function updateSystemTime() {
  const el = document.getElementById('system-time');
  if (el) el.textContent = `Mission Control · ${new Date().toLocaleDateString()} · ${new Date().toLocaleTimeString()}`;
  setTimeout(updateSystemTime, 1000);
}

// ============================================================
// REVEAL SCREEN
// ============================================================
function launchReveal() {
  const i = state.selectedHomeClass;
  if (i === null) return;
  const cls = state.classes[i];
  if (!cls.pendingDeltas) { toast('No pending reveal for this class.', 'error'); return; }
  state.activeClass = i;
  renderRevealScreen(cls);
  showScreen('screen-reveal');
}

function renderRevealScreen(cls) {
  document.getElementById('reveal-class-label').textContent = cls.name + ' — Yesterday\'s Decision';
  document.getElementById('reveal-choice-recap').textContent = cls.pendingChoiceText || '—';

  // Find consequence text from content
  const content = getContentForClass(cls);
  const prevDay = getPrevDayContent(cls);
  let consequenceText = '';
  let gaiaText = '"The data is in. Here is what happened as a result of your decision."';

  if (prevDay && cls.pendingChoiceText) {
    const matchChoice = prevDay.choices?.find(c => c.text === cls.pendingChoiceText);
    if (matchChoice?.consequence) {
      consequenceText = matchChoice.consequence;
      gaiaText = `"${consequenceText}"`;
    }
  }

  document.getElementById('reveal-gaia-text').innerHTML = gaiaText.replace(/\*(.*?)\*/g, '<em>$1</em>');

  // Show stat changes
  const changes = document.getElementById('reveal-stat-changes');
  const deltas = cls.pendingDeltas || {};
  const statInfo = [
    { key:'power', icon:'⚡', label:'Power', color:'#00c8ff' },
    { key:'hull',  icon:'🛡', label:'Hull Integrity', color:'#00ff88' },
    { key:'data',  icon:'📡', label:'Data Collected', color:'#aa66ff' },
    { key:'morale',icon:'👥', label:'Crew Morale', color:'#ffaa00' }
  ];

  changes.innerHTML = statInfo.map(s => {
    const d = deltas[s.key] || 0;
    const current = cls.stats[s.key];
    const future = Math.max(0, Math.min(100, current + d));
    const deltaClass = d > 0 ? 'delta-pos' : d < 0 ? 'delta-neg' : 'delta-neu';
    const deltaText = d > 0 ? `+${d}%` : d < 0 ? `${d}%` : '—';
    return `
      <div class="stat-change-card">
        <div class="stat-change-icon">${s.icon}</div>
        <div class="stat-change-body">
          <div class="stat-change-name">${s.label}</div>
          <div class="stat-change-bar"><div class="stat-change-fill" style="width:${future}%;background:${s.color}"></div></div>
          <div class="stat-change-delta ${deltaClass}">${deltaText} → ${future}%</div>
        </div>
      </div>
    `;
  }).join('');
}

function proceedFromReveal() {
  // NOW apply the pending deltas
  const cls = state.classes[state.activeClass];
  if (cls.pendingDeltas) {
    Object.entries(cls.pendingDeltas).forEach(([key, val]) => {
      cls.stats[key] = Math.max(0, Math.min(100, cls.stats[key] + val));
    });
    cls.pendingDeltas = null;
    cls.pendingChoiceText = null;
  }
  save();
  launchMission();
}

// ============================================================
// MISSION SCREEN
// ============================================================
function launchMission() {
  if (state.selectedHomeClass !== null && state.activeClass === null) {
    state.activeClass = state.selectedHomeClass;
  }
  if (state.activeClass === null) return;
  state.currentPhase = 'story';
  state.selectedChoice = null;
  renderMissionScreen();
  showScreen('screen-mission');
}

function renderMissionScreen() {
  const cls = state.classes[state.activeClass];
  const content = getContentForClass(cls);

  document.getElementById('topbar-period').textContent = cls.name;
  document.getElementById('topbar-act').textContent = content.actLabel;
  document.getElementById('content-act-label').textContent = content.actLabel;
  document.getElementById('content-act-title').textContent = content.actTitle;
  document.getElementById('content-gaia').innerHTML = content.gaia;
  document.getElementById('content-scenario').textContent = content.scenario || '';

  renderChoices(cls, content.choices);
  renderStats(cls);
  renderDecisionLog(cls);
  updateFailureDots(cls);
  document.getElementById('branch-path').innerHTML = `Act ${cls.act} · <span>Branch ${cls.branch}</span> · Day ${cls.day}`;

  setPhase('story');
  state.selectedChoice = null;
  document.getElementById('btn-commit').disabled = true;
  document.getElementById('commit-note').textContent = 'Select the crew\'s official choice, then lock it in.';

  checkStatAlerts(cls);
}

function getContentForClass(cls) {
  const act = CONTENT.acts.find(a => a.id === cls.act) || CONTENT.acts[0];
  return act.days.find(d => d.day === cls.day) || act.days[0];
}

function getPrevDayContent(cls) {
  const act = CONTENT.acts.find(a => a.id === cls.act);
  if (!act) return null;
  return act.days.find(d => d.day === cls.day - 1) || null;
}

// ============================================================
// PHASE SYSTEM
// ============================================================
function setPhase(phase) {
  state.currentPhase = phase;
  document.querySelectorAll('.phase-step').forEach(el => {
    const p = el.dataset.phase;
    el.classList.remove('active','done');
    const order = ['story','exit','discuss','vote'];
    const phaseIdx = order.indexOf(phase);
    const elIdx = order.indexOf(p);
    if (elIdx < phaseIdx) el.classList.add('done');
    else if (elIdx === phaseIdx) el.classList.add('active');
  });
  document.querySelectorAll('.phase-panel').forEach(el => el.classList.remove('active'));
  const panel = document.getElementById('phase-' + phase);
  if (panel) panel.classList.add('active');

  // Update choices label
  const label = document.getElementById('choices-label');
  if (phase === 'vote') {
    label.textContent = 'Crew Decision — Phase 4: Official Vote';
    document.getElementById('choices-area').style.opacity = '1';
    document.getElementById('choices-area').style.pointerEvents = 'auto';
  } else {
    label.textContent = 'Crew Decision — Available in Phase 4: Final Vote';
    document.getElementById('choices-area').style.opacity = '0.4';
    document.getElementById('choices-area').style.pointerEvents = 'none';
  }
}

// ============================================================
// TIMER
// ============================================================
let _timerSeconds = 0;
let _timerRunning = false;
let _timerInterval = null;
let _activeTimerPhase = null;

function startPhaseTimer(phase) {
  stopTimer();
  _activeTimerPhase = phase;
  const inputId = phase === 'exit' ? 'exit-timer-input' : 'discuss-timer-input';
  const mins = parseInt(document.getElementById(inputId).value) || 5;
  _timerSeconds = mins * 60;
  _timerRunning = true;
  _timerInterval = setInterval(tickTimer, 1000);
  document.getElementById(`${phase}-timer-done`).style.display = 'none';
  updateTimerDisplays();
}

function stopTimer() {
  _timerRunning = false;
  if (_timerInterval) { clearInterval(_timerInterval); _timerInterval = null; }
  updateTimerDisplays();
}

function addTime(mins) {
  _timerSeconds += mins * 60;
  if (!_timerRunning && _timerSeconds > 0 && _activeTimerPhase) {
    _timerRunning = true;
    _timerInterval = setInterval(tickTimer, 1000);
  }
  updateTimerDisplays();
}

function addTimeTopbar(mins) { addTime(mins); }

function focusTimer() {
  if (_activeTimerPhase) setPhase(_activeTimerPhase);
}

function tickTimer() {
  if (!_timerRunning) return;
  _timerSeconds = Math.max(0, _timerSeconds - 1);
  updateTimerDisplays();
  if (_timerSeconds === 0) {
    _timerRunning = false;
    clearInterval(_timerInterval);
    onTimerDone();
  }
}

function onTimerDone() {
  if (_activeTimerPhase) {
    const doneEl = document.getElementById(`${_activeTimerPhase}-timer-done`);
    if (doneEl) doneEl.style.display = 'block';
  }
  toast('Time is up!', '');
}

function updateTimerDisplays() {
  const m = Math.floor(_timerSeconds / 60);
  const s = _timerSeconds % 60;
  const str = `${m}:${s.toString().padStart(2,'0')}`;

  // Determine color class
  let cls = 'idle';
  if (_timerSeconds === 0 && !_timerRunning && _activeTimerPhase) cls = 'done';
  else if (!_timerRunning) cls = 'idle';
  else if (_timerSeconds <= 60) cls = 'urgent';
  else if (_timerSeconds <= 120) cls = 'low';
  else cls = 'running';

  // Topbar
  const topbar = document.getElementById('topbar-timer');
  if (topbar) { topbar.textContent = _timerRunning || _timerSeconds > 0 ? str : '--:--'; topbar.className = 'timer-readout ' + cls; }

  // Phase panels
  ['exit','discuss'].forEach(phase => {
    const el = document.getElementById(`${phase}-timer-display`);
    if (!el) return;
    if (_activeTimerPhase === phase) { el.textContent = str; el.className = 'big-timer ' + cls; }
    else if (_activeTimerPhase === null) { el.textContent = '--:--'; el.className = 'big-timer idle'; }
  });
}

// ============================================================
// CHOICES
// ============================================================
function renderChoices(cls, choices) {
  const grid = document.getElementById('choice-grid');
  grid.innerHTML = '';
  const restricted = cls.failures >= 2;
  document.getElementById('choices-restricted').style.display = restricted ? 'block' : 'none';

  if (!choices || choices.length === 0) {
    grid.innerHTML = '<div style="font-family:var(--font-mono);font-size:11px;color:var(--text-dim);font-style:italic;padding:6px 0">No vote required for this session.</div>';
    return;
  }

  // When restricted, mark lowest-impact option as eliminated
  choices.forEach((choice, i) => {
    const isEliminated = restricted && i === choices.length - 1 && choices.length > 2;
    const btn = document.createElement('div');
    btn.className = 'choice-btn' + (isEliminated ? ' eliminated' : '');
    btn.id = `choice-${i}`;
    if (!isEliminated) btn.onclick = () => selectChoice(i);
    btn.innerHTML = `
      <div class="choice-letter">${choice.letter}</div>
      <div>
        <div class="choice-text">${choice.text}</div>
        ${choice.subtext ? `<div class="choice-subtext">${choice.subtext}</div>` : ''}
      </div>
    `;
    grid.appendChild(btn);
  });
}

function selectChoice(i) {
  if (state.currentPhase !== 'vote') {
    toast('Move to Phase 4: Final Vote to commit a decision.', '');
    return;
  }
  state.selectedChoice = i;
  document.querySelectorAll('.choice-btn').forEach((b,idx) => b.classList.toggle('selected', idx === i));
  const content = getContentForClass(state.classes[state.activeClass]);
  const choice = content.choices[i];
  document.getElementById('btn-commit').disabled = false;
  document.getElementById('commit-note').innerHTML = `"${choice.text}"`;
}

// ============================================================
// COMMIT FLOW — stats NOT applied until reveal
// ============================================================
function openCommitModal() {
  if (state.selectedChoice === null) return;
  const cls = state.classes[state.activeClass];
  const content = getContentForClass(cls);
  const choice = content.choices[state.selectedChoice];
  document.getElementById('commit-modal-body').innerHTML = `
    The crew has officially voted:<br><br>
    <strong style="color:var(--text-primary)">"${choice.text}"</strong><br><br>
    <span style="font-family:var(--font-mono);font-size:11px;color:var(--text-dim)">This decision will be logged. Consequences will be revealed next class. Stats will update during the reveal.</span>
  `;
  state.pendingCommit = choice;
  document.getElementById('modal-commit').classList.add('visible');
}

function executeCommit() {
  closeModal('modal-commit');
  const cls = state.classes[state.activeClass];
  const choice = state.pendingCommit;

  // Store deltas as PENDING — do NOT apply yet
  cls.pendingDeltas = { ...choice.deltas };
  cls.pendingChoiceText = choice.text;
  cls.branch = choice.branch || cls.branch;

  // Log the decision
  cls.decisions.push({
    date: new Date().toLocaleDateString(),
    act: cls.act,
    day: cls.day,
    choiceText: choice.text,
    choiceLetter: choice.letter,
    branch: choice.branch,
    deltas: choice.deltas
  });

  // Advance day
  cls.day += 1;

  // Save checkpoint at act boundaries
  if (!cls.checkpoint) {
    cls.checkpoint = { act:cls.act, day:1, stats:{...cls.stats}, branch:cls.branch };
  }

  save();

  // Show processing screen
  document.getElementById('processing-choice-text').textContent = choice.text;
  showScreen('screen-processing');
}

function saveAndGoHome() {
  save();
  goHome();
}

function continueMission() {
  renderMissionScreen();
  showScreen('screen-mission');
}

function goToReveal() {
  const cls = state.classes[state.activeClass];
  if (!cls.pendingDeltas) { toast('No pending reveal for this class yet.', ''); return; }
  renderRevealScreen(cls);
  showScreen('screen-reveal');
}

// ============================================================
// STATS DISPLAY
// ============================================================
function renderStats(cls) {
  const stats = cls.stats;
  ['power','hull','data','morale'].forEach(key => {
    const val = Math.max(0, Math.min(100, stats[key]));
    document.getElementById(`stat-${key}-val`).textContent = val + '%';
    document.getElementById(`stat-${key}-bar`).style.width = val + '%';
    const item = document.querySelector(`.stat-${key}`);
    item.classList.remove('stat-warning','stat-critical');
    if (val <= 20) item.classList.add('stat-critical');
    else if (val <= 30) item.classList.add('stat-warning');
  });
  document.getElementById('stat-power-status').textContent = statLabel('power', stats.power);
  document.getElementById('stat-hull-status').textContent = statLabel('hull', stats.hull);
  document.getElementById('stat-data-status').textContent = statLabel('data', stats.data);
  document.getElementById('stat-morale-status').textContent = statLabel('morale', stats.morale);
}

function statLabel(key, val) {
  const labels = {
    power: ['🚨 Critical', '⚠ Low reserves', 'Reserves reduced', 'Reserves nominal'],
    hull:  ['🚨 Breach imminent', '⚠ Structural concern', 'Minor stress', 'Integrity nominal'],
    data:  ['Awaiting collection', 'Early collection', 'Building record', 'Strong record'],
    morale:['🚨 Critical failure', '⚠ Crew struggling', '⚠ Crew strained', 'Crew focused', 'Crew ready']
  };
  const thresholds = key === 'morale'
    ? [[20,'🚨 Critical failure'],[40,'⚠ Crew struggling'],[60,'⚠ Crew strained'],[80,'Crew focused'],[101,'Crew ready']]
    : [[20,'🚨 ' + (key==='power'?'Critical':'Breach imminent')],[30,'⚠ ' + (key==='power'?'Low reserves':key==='hull'?'Structural concern':'')],[60,'Reduced'],[101,'Nominal']];

  for (const [threshold, label] of thresholds) {
    if (val < threshold) return label;
  }
  return 'Nominal';
}

function checkStatAlerts(cls) {
  const alerts = [];
  const s = cls.stats;
  if (s.hull <= 20) alerts.push('"Hull integrity is critical. Structural failure is no longer hypothetical."');
  if (s.power <= 20) alerts.push('"Power reserves near depletion. Essential systems only."');
  if (s.morale <= 30) alerts.push('"Crew morale is affecting performance. I recommend acknowledging this."');
  const critCount = [s.power, s.hull, s.morale].filter(v => v <= 20).length;
  if (critCount >= 2) alerts.push('"Two or more systems critical simultaneously. This is the failure profile I hoped to avoid."');

  const box = document.getElementById('gaia-alerts');
  box.innerHTML = alerts.length
    ? alerts.map(a => `<div class="gaia-alert" style="margin-bottom:6px"><div class="gaia-alert-text">${a}</div></div>`).join('')
    : '<div class="gaia-alert"><div class="gaia-alert-text">"All systems monitored. Awaiting crew input."</div></div>';

  if (s.hull <= 0 || critCount >= 2 && [s.power, s.hull].some(v => v <= 0)) triggerExtinction();
}

function updateFailureDots(cls) {
  for (let i = 0; i < 3; i++) {
    document.getElementById(`fdot-${i}`).classList.toggle('active', i < cls.failures);
  }
  const notice = document.getElementById('restriction-notice');
  if (cls.failures === 0) { notice.style.display = 'none'; return; }
  notice.style.display = 'block';
  notice.textContent = cls.failures === 1
    ? 'One failure logged. Second failure restricts choices.'
    : cls.failures === 2
    ? 'GAIA: "Choices are now restricted to the most viable options."'
    : 'GAIA: "I have narrowed your options significantly. Please try not to make me regret it."';
}

// ============================================================
// DECISION LOG
// ============================================================
function renderDecisionLog(cls) {
  const container = document.getElementById('decision-log-entries');
  const decisions = cls.decisions.slice(-5).reverse();
  if (decisions.length === 0) {
    container.innerHTML = '<div style="font-family:var(--font-mono);font-size:10px;color:var(--text-dim);font-style:italic">No decisions yet.</div>';
    return;
  }
  container.innerHTML = decisions.map(d => {
    const impacts = Object.entries(d.deltas || {}).map(([key, val]) =>
      `<span class="impact-tag ${val > 0 ? 'impact-pos' : val < 0 ? 'impact-neg' : 'impact-neu'}">${key} ${val > 0 ? '+' : ''}${val || '—'}</span>`
    ).join('');
    return `<div class="log-entry">
      <div class="log-date">${d.date} · Act ${d.act} Day ${d.day}</div>
      <div class="log-choice">${d.choiceText}</div>
      <div class="log-impact">${impacts}</div>
    </div>`;
  }).join('');
}

// ============================================================
// NAVIGATION
// ============================================================
function advanceToNextDay() {
  if (state.activeClass === null) return;
  const cls = state.classes[state.activeClass];
  const act = CONTENT.acts.find(a => a.id === cls.act);
  if (!act) return;
  const nextDayContent = act.days.find(d => d.day === cls.day + 1);
  if (nextDayContent) {
    cls.day += 1;
  } else {
    const nextAct = CONTENT.acts.find(a => a.id === cls.act + 1);
    if (nextAct) {
      cls.act += 1; cls.day = 1;
      cls.checkpoint = { act:cls.act, day:1, stats:{...cls.stats}, branch:cls.branch };
      toast(`Advanced to Act ${cls.act}`, 'success');
    } else { toast('Campaign complete — all acts finished.', 'success'); return; }
  }
  save();
  renderMissionScreen();
}

function saveCurrentClass() {
  save();
  toast(`${state.classes[state.activeClass]?.name || 'Class'} saved.`, 'success');
}

function goHome() {
  save();
  stopTimer();
  state.activeClass = null;
  showHome();
}

function resumeMission() {
  if (state.activeClass !== null) { renderMissionScreen(); showScreen('screen-mission'); }
  else goHome();
}

// ============================================================
// EXTINCTION / FORENSICS
// ============================================================
function triggerExtinction() { document.getElementById('modal-extinction').classList.add('visible'); }

function confirmExtinction() {
  closeModal('modal-extinction');
  const cls = state.classes[state.activeClass];
  cls.failures = Math.min(3, cls.failures + 1);
  if (cls.checkpoint) {
    cls.act = cls.checkpoint.act; cls.day = cls.checkpoint.day;
    cls.stats = {...cls.checkpoint.stats}; cls.branch = cls.checkpoint.branch;
  }
  cls.pendingDeltas = null; cls.pendingChoiceText = null;
  save();
  showForensics();
}

function showForensics() {
  const idx = state.activeClass !== null ? state.activeClass : state.selectedHomeClass;
  if (idx === null) { showHome(); return; }
  const cls = state.classes[idx];
  const msgs = [
    '"The mission has ended. Before we proceed, we owe it to the Prometheus crew to understand what happened — and why. Let\'s find out together."',
    '"We\'ve been here before. That concerns me. Let\'s be more careful this time about identifying where the reasoning failed."',
    '"Three failures. I\'ve narrowed your future options significantly. But first: let\'s understand why we keep arriving at this moment."'
  ];
  document.getElementById('forensics-gaia-text').textContent = msgs[Math.min(cls.failures, msgs.length - 1)];
  const entries = document.getElementById('timeline-entries');
  const recent = cls.decisions.slice(-7).reverse();
  entries.innerHTML = recent.length === 0
    ? '<div style="font-family:var(--font-mono);font-size:11px;color:var(--text-dim);font-style:italic;padding:8px">No decisions logged yet.</div>'
    : recent.map((d,i) => {
        const impacts = Object.entries(d.deltas || {}).map(([key,val]) =>
          `<span class="impact-tag ${val>0?'impact-pos':val<0?'impact-neg':'impact-neu'}">${key} ${val>0?'+':''}${val||'—'}</span>`
        ).join('');
        return `<div class="timeline-entry">
          <div class="timeline-num">${i+1}</div>
          <div>
            <div class="timeline-date">${d.date} · Act ${d.act} · Day ${d.day}</div>
            <div class="timeline-choice">${d.choiceLetter ? d.choiceLetter + '. ' : ''}${d.choiceText}</div>
            <div class="timeline-impact">${impacts}</div>
          </div>
        </div>`;
      }).join('');
  showScreen('screen-forensics');
}

// ============================================================
// RESETS
// ============================================================
function confirmReset() {
  if (state.selectedHomeClass === null) { toast('Select a class first.', 'error'); return; }
  const cls = state.classes[state.selectedHomeClass];
  document.getElementById('reset-modal-body').textContent =
    `Reset ${cls.name} to the last checkpoint (Act ${cls.checkpoint?.act || 1} Day ${cls.checkpoint?.day || 1})? Decisions since then will be lost.`;
  document.getElementById('modal-reset').classList.add('visible');
}

function executeReset() {
  closeModal('modal-reset');
  const cls = state.classes[state.selectedHomeClass];
  if (cls.checkpoint) {
    cls.act = cls.checkpoint.act; cls.day = cls.checkpoint.day;
    cls.stats = {...cls.checkpoint.stats}; cls.branch = cls.checkpoint.branch;
  } else {
    cls.act=1; cls.day=1; cls.branch='A'; cls.stats={power:100,hull:100,data:0,morale:100}; cls.decisions=[];
  }
  cls.pendingDeltas = null; cls.pendingChoiceText = null;
  save(); renderClassCards(); toast(`${cls.name} reset.`, '');
}

function confirmFullReset() {
  if (state.selectedHomeClass === null) { toast('Select a class first.', 'error'); return; }
  document.getElementById('full-reset-modal-body').textContent =
    `Full reset ${state.classes[state.selectedHomeClass].name}? ALL progress wiped. Cannot be undone.`;
  document.getElementById('modal-full-reset').classList.add('visible');
}

function executeFullReset() {
  closeModal('modal-full-reset');
  const cls = state.classes[state.selectedHomeClass];
  cls.act=1; cls.day=1; cls.branch='A'; cls.failures=0;
  cls.stats={power:100,hull:100,data:0,morale:100};
  cls.decisions=[]; cls.checkpoint=null;
  cls.pendingDeltas=null; cls.pendingChoiceText=null;
  save(); renderClassCards(); toast(`${cls.name} fully reset.`, '');
}

// ============================================================
// UTILITIES
// ============================================================
function showScreen(id) {
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  document.getElementById(id).classList.add('active');
}

function closeModal(id) { document.getElementById(id).classList.remove('visible'); }

function toast(msg, type) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.className = 'toast visible' + (type ? ' ' + type : '');
  setTimeout(() => t.classList.remove('visible'), 3000);
}

// ============================================================
// BOOT
// ============================================================
window.addEventListener('load', () => {
  const loaded = load();
  if (loaded && state.configured) showHome();
  else showScreen('screen-setup');
});
</script>
</body>
