    flex-shrink: 0;
  }

  .choices-label { font-family: var(--font-mono); font-size: 9px; color: var(--text-dim); letter-spacing: .15em; text-transform: uppercase; margin-bottom: 10px; }

  .choices-restricted {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--amber);
    background: rgba(255,170,0,0.07);
    border: 1px solid rgba(255,170,0,0.2);
    border-radius: 4px;
    padding: 6px 10px;
    margin-bottom: 8px;
  }

  .choice-grid { display: grid; gap: 8px; }

  .choice-btn {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px 16px;
    cursor: pointer;
    transition: all 0.2s;
    text-align: left;
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: 10px;
    align-items: start;
  }

  .choice-btn:hover { border-color: var(--accent-dim); background: var(--bg-card2); transform: translateX(2px); }
  .choice-btn.selected { border-color: var(--accent); background: rgba(0,200,255,0.07); }
  .choice-btn.eliminated { opacity: 0.3; cursor: not-allowed; }

  .choice-letter { font-family: var(--font-display); font-size: 13px; font-weight: 700; color: var(--accent); padding-top: 1px; }
  .choice-text { font-family: var(--font-body); font-size: 15px; font-weight: 500; color: var(--text-primary); line-height: 1.4; }
  .choice-subtext { font-family: var(--font-mono); font-size: 10px; color: var(--text-secondary); margin-top: 3px; line-height: 1.4; }

  .commit-row { margin-top: 10px; display: flex; gap: 10px; align-items: center; }

  .btn-commit {
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .1em;
    padding: 11px 26px;
    border-radius: 4px;
    border: none;
    cursor: pointer;
    background: var(--green);
    color: var(--bg-deep);
    box-shadow: 0 0 16px rgba(0,255,136,0.3);
    transition: all 0.2s;
  }
  .btn-commit:hover { box-shadow: 0 0 24px rgba(0,255,136,0.5); transform: translateY(-1px); }
  .btn-commit:disabled { opacity: 0.3; cursor: not-allowed; transform: none; box-shadow: none; }

  .commit-note { font-family: var(--font-mono); font-size: 10px; color: var(--text-dim); line-height: 1.5; }

  /* RIGHT PANEL */
  .panel-right {
    background: var(--bg-panel);
    border-left: 1px solid var(--border);
    padding: 14px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .gaia-alert { background: var(--bg-card); border: 1px solid rgba(0,255,136,0.2); border-left: 3px solid var(--gaia-green); border-radius: 5px; padding: 10px 12px; margin-bottom: 6px; }
  .gaia-alert-text { font-family: var(--font-mono); font-size: 11px; color: var(--gaia-green); line-height: 1.6; font-style: italic; }

  .nav-btn {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--text-secondary);
    background: var(--bg-card);
    border: 1px solid var(--border);
    padding: 8px 12px;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.15s;
    letter-spacing: .04em;
    text-transform: uppercase;
    text-align: left;
    width: 100%;
    margin-bottom: 5px;
  }
  .nav-btn:hover { border-color: var(--accent-dim); color: var(--accent); }
  .nav-btn.danger { color: var(--red); border-color: rgba(255,51,85,0.25); }
  .nav-btn.danger:hover { background: rgba(255,51,85,0.07); border-color: var(--red); }

  .branch-display { background: var(--bg-card); border: 1px solid var(--border); border-radius: 5px; padding: 9px 11px; }
  .branch-path { font-family: var(--font-mono); font-size: 11px; color: var(--text-secondary); line-height: 1.6; }
  .branch-path span { color: var(--accent); }

  .divider-line { height: 1px; background: var(--border); }

  /* ===================== PROCESSING SCREEN ===================== */
  #screen-processing {
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }

  .processing-inner { width: 100%; max-width: 600px; text-align: center; }

  .processing-icon {
    font-size: 48px;
    margin-bottom: 20px;
    animation: spin-slow 4s linear infinite;
    display: inline-block;
  }

  @keyframes spin-slow { from{transform:rotate(0deg)}to{transform:rotate(360deg)} }

  .processing-title {
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: .08em;
    margin-bottom: 8px;
    text-shadow: 0 0 30px rgba(0,200,255,0.4);
  }

  .processing-subtitle {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-secondary);
    letter-spacing: .1em;
    margin-bottom: 32px;
  }

  .processing-gaia {
    background: var(--bg-card);
    border: 1px solid rgba(0,255,136,0.2);
    border-left: 3px solid var(--gaia-green);
    border-radius: 6px;
    padding: 18px 22px;
    margin-bottom: 28px;
    text-align: left;
  }

  .processing-gaia-text {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--gaia-green);
    line-height: 1.75;
    font-style: italic;
  }

  .processing-choice-recap {
    background: var(--bg-card);
    border: 1px solid var(--border-bright);
    border-radius: 6px;
    padding: 14px 18px;
    margin-bottom: 24px;
    text-align: left;
  }

  .processing-choice-label {
    font-family: var(--font-mono);
    font-size: 9px;
    color: var(--text-dim);
    letter-spacing: .12em;
    text-transform: uppercase;
    margin-bottom: 6px;
  }

  .processing-choice-text {
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--text-primary);
    line-height: 1.5;
  }

  .processing-stats-row {
    display: flex;
    gap: 8px;
    justify-content: center;
    margin-bottom: 28px;
    flex-wrap: wrap;
  }

  .processing-stat-chip {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 6px 14px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-dim);
    letter-spacing: .06em;
  }

  .processing-actions { display: flex; gap: 12px; justify-content: center; }

  /* ===================== REVEAL SCREEN ===================== */
  #screen-reveal {
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }

  .reveal-inner { width: 100%; max-width: 700px; }

  .reveal-title {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 900;
    color: var(--amber);
    letter-spacing: .06em;
    margin-bottom: 6px;
    text-shadow: 0 0 30px rgba(255,170,0,0.4);
    text-align: center;
  }

  .reveal-subtitle { font-family: var(--font-mono); font-size: 11px; color: var(--text-secondary); letter-spacing: .1em; margin-bottom: 28px; text-align: center; }

  .reveal-recap {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 14px 18px;
    margin-bottom: 20px;
  }

  .reveal-recap-label { font-family: var(--font-mono); font-size: 9px; color: var(--text-dim); letter-spacing: .12em; text-transform: uppercase; margin-bottom: 6px; }
  .reveal-recap-text { font-family: var(--font-body); font-size: 15px; color: var(--text-secondary); line-height: 1.5; }

  .reveal-gaia-box {
    background: var(--bg-card);
    border: 1px solid rgba(0,255,136,0.25);
    border-left: 3px solid var(--gaia-green);
    border-radius: 6px;
    padding: 18px 20px;
    margin-bottom: 24px;
  }

  .reveal-gaia-text { font-family: var(--font-body); font-size: 17px; color: var(--text-primary); line-height: 1.75; }
  .reveal-gaia-text em { color: var(--gaia-green); font-style: italic; }
  .reveal-gaia-text strong { color: var(--amber); font-weight: 600; }

  /* STAT CHANGE DISPLAY */
  .stat-changes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-bottom: 24px;
  }

  .stat-change-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px 14px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .stat-change-icon { font-size: 18px; flex-shrink: 0; }

  .stat-change-body { flex: 1; }
  .stat-change-name { font-family: var(--font-mono); font-size: 10px; color: var(--text-dim); text-transform: uppercase; letter-spacing: .06em; margin-bottom: 3px; }
  .stat-change-bar { height: 5px; background: rgba(255,255,255,0.06); border-radius: 3px; overflow: hidden; margin-bottom: 3px; }
  .stat-change-fill { height: 100%; border-radius: 3px; transition: width 1.2s cubic-bezier(0.4,0,0.2,1); }
  .stat-change-delta { font-family: var(--font-mono); font-size: 12px; font-weight: 500; }
  .delta-pos { color: var(--green); }
  .delta-neg { color: var(--red); }
  .delta-neu { color: var(--text-dim); }

  /* ===================== FORENSICS SCREEN ===================== */
  #screen-forensics {
    align-items: center;
    justify-content: flex-start;
    padding: 2rem;
  }

  .forensics-inner { width: 100%; max-width: 800px; }

  .forensics-title {
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 700;
    color: var(--red);
    text-shadow: 0 0 24px rgba(255,51,85,0.4);
    letter-spacing: .05em;
    margin-bottom: 6px;
    text-align: center;
  }

  .timeline { background: var(--bg-card); border: 1px solid var(--border); border-radius: 6px; padding: 16px; margin-bottom: 1.5rem; }
  .timeline-title { font-family: var(--font-mono); font-size: 9px; color: var(--text-dim); letter-spacing: .1em; text-transform: uppercase; margin-bottom: 12px; }

  .timeline-entry { display: grid; grid-template-columns: 22px 1fr; gap: 10px; margin-bottom: 12px; padding-bottom: 12px; border-bottom: 1px solid var(--border); }
  .timeline-entry:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
  .timeline-num { font-family: var(--font-mono); font-size: 11px; color: var(--text-dim); padding-top: 2px; }
  .timeline-date { font-family: var(--font-mono); font-size: 9px; color: var(--text-dim); margin-bottom: 2px; }
  .timeline-choice { font-family: var(--font-body); font-size: 14px; color: var(--text-primary); margin-bottom: 4px; }
  .timeline-impact { display: flex; gap: 4px; flex-wrap: wrap; }

  .cer-framework { display: grid; gap: 10px; margin-bottom: 1.5rem; }
  .cer-section { background: var(--bg-card); border: 1px solid var(--border); border-radius: 6px; padding: 14px; }
  .cer-section-label { font-family: var(--font-display); font-size: 11px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; margin-bottom: 5px; }
  .cer-section-prompt { font-family: var(--font-body); font-size: 14px; color: var(--text-secondary); line-height: 1.6; }
  .claim-label { color: var(--red); }
  .evidence-label { color: var(--amber); }
  .reasoning-label { color: var(--purple); }

  /* ===================== MODALS ===================== */
  .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.82); z-index: 100; display: none; align-items: center; justify-content: center; backdrop-filter: blur(4px); }
  .modal-overlay.visible { display: flex; }
  .modal { background: var(--bg-panel); border: 1px solid var(--border-bright); border-radius: 8px; padding: 26px; max-width: 480px; width: 90%; }
  .modal-title { font-family: var(--font-display); font-size: 17px; font-weight: 700; color: var(--accent); letter-spacing: .05em; margin-bottom: 14px; }
  .modal-body { font-family: var(--font-body); font-size: 15px; color: var(--text-secondary); line-height: 1.6; margin-bottom: 20px; }
  .modal-actions { display: flex; gap: 10px; justify-content: flex-end; flex-wrap: wrap; }
  .extinction-modal .modal-title { color: var(--red); }

  /* TOAST */
  .toast { position: fixed; bottom: 20px; right: 20px; background: var(--bg-card); border: 1px solid var(--border-bright); border-radius: 6px; padding: 10px 16px; font-family: var(--font-mono); font-size: 11px; color: var(--accent); z-index: 200; transform: translateY(60px); opacity: 0; transition: all 0.3s; }
  .toast.visible { transform: translateY(0); opacity: 1; }
  .toast.success { border-color: rgba(0,255,136,0.4); color: var(--green); }
  .toast.error { border-color: rgba(255,51,85,0.4); color: var(--red); }

  ::-webkit-scrollbar { width: 4px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: var(--border-bright); border-radius: 2px; }
</style>
</head>
<body>
<div class="app">

<!-- ===================== SETUP ===================== -->
<div id="screen-setup" class="screen active">
  <div style="display:flex;align-items:center;justify-content:center;min-height:100vh;padding:2rem">
    <div style="width:100%;max-width:600px">
      <div class="mission-label" style="margin-bottom:8px">Mission Control — Initial Configuration</div>
      <div class="setup-title">THE PROMETHEUS DRIFT</div>
      <div class="setup-sub" style="margin-bottom:2rem">First-time setup. This only runs once — you can update settings anytime from the dashboard.</div>

      <div class="form-group">
        <label class="form-label">Your Name</label>
        <input type="text" class="form-input" id="setup-teacher" placeholder="e.g. Ms. Rodriguez" />
      </div>

      <div class="form-group">
        <label class="form-label">Name Your Three Classes</label>
        <div class="period-setup-grid">
          <div class="period-setup-card">
            <div class="period-setup-label">Class 1</div>
            <input type="text" class="form-input" id="setup-class1" placeholder="e.g. Period 1" />
          </div>
          <div class="period-setup-card">
            <div class="period-setup-label">Class 2</div>
            <input type="text" class="form-input" id="setup-class2" placeholder="e.g. Period 3" />
          </div>
          <div class="period-setup-card">
            <div class="period-setup-label">Class 3</div>
            <input type="text" class="form-input" id="setup-class3" placeholder="e.g. Period 5" />
          </div>
        </div>
      </div>

      <button class="btn btn-primary" style="width:100%;margin-top:8px" onclick="completeSetup()">
        Initialize Mission Control →
      </button>
    </div>
  </div>
</div>

<!-- ===================== HOME ===================== -->
<div id="screen-home" class="screen">
  <div style="display:flex;align-items:center;justify-content:center;min-height:100vh;padding:2rem">
    <div style="width:100%;max-width:960px">
      <div class="mission-header">
        <div class="mission-label">Global Science Recovery Agency — Mission Control</div>
        <div class="mission-title">THE PROMETHEUS DRIFT</div>
        <div class="mission-subtitle">Physical Science Campaign · Teacher Dashboard</div>
      </div>

      <div class="class-grid" id="class-grid"></div>

      <div class="home-actions">
        <button class="btn btn-green" id="btn-reveal" onclick="launchReveal()" disabled>
          ◈ Open Today's Reveal
        </button>
        <button class="btn btn-primary" id="btn-launch" onclick="launchMission()" disabled>
          ▶ Launch Mission Screen
        </button>
        <button class="btn btn-secondary" onclick="showForensics()">
          ⬡ Mission Forensics
        </button>
        <button class="btn btn-secondary" onclick="showSetup()">◈ Settings</button>
        <button class="btn btn-danger" onclick="confirmReset()">↺ Reset to Checkpoint</button>
        <button class="btn btn-danger" onclick="confirmFullReset()">✕ Full Reset Class</button>
      </div>

      <div class="system-time" id="system-time"></div>
    </div>
  </div>
</div>

<!-- ===================== REVEAL SCREEN ===================== -->
<div id="screen-reveal" class="screen">
  <div style="display:flex;align-items:center;justify-content:center;min-height:100vh;padding:2rem">
    <div class="reveal-inner">
      <div class="mission-label" style="text-align:center;margin-bottom:8px" id="reveal-class-label">—</div>
      <div class="reveal-title">RESULTS ARE IN.</div>
      <div class="reveal-subtitle">Your decision has been processed. Here is what happened.</div>

      <div class="reveal-recap">
        <div class="reveal-recap-label">Last Class — The Crew Decided</div>
        <div class="reveal-recap-text" id="reveal-choice-recap">—</div>
      </div>

      <div class="reveal-gaia-box">
        <div class="gaia-header" style="margin-bottom:10px">
          <div class="gaia-dot"></div>
          <div class="gaia-label">GAIA — Consequence Report</div>
        </div>
        <div class="reveal-gaia-text" id="reveal-gaia-text">Loading consequence data...</div>
      </div>

      <div class="stat-changes" id="reveal-stat-changes"></div>

      <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
        <button class="btn btn-primary" onclick="proceedFromReveal()">▶ Continue to Today's Mission</button>
        <button class="btn btn-secondary" onclick="goHome()">⌂ Back to Dashboard</button>
      </div>
    </div>
  </div>
</div>

<!-- ===================== MISSION SCREEN ===================== -->
<div id="screen-mission" class="screen">
  <!-- TOPBAR -->
  <div class="topbar">
    <div class="topbar-left">
      <div class="topbar-title">PROMETHEUS DRIFT</div>
      <div class="topbar-tag" id="topbar-period">—</div>
      <div class="topbar-tag" id="topbar-act" style="color:var(--accent-dim)">—</div>
    </div>
    <div class="topbar-right">
      <!-- TIMER WIDGET -->
      <div class="timer-widget">
        <div class="timer-readout idle" id="topbar-timer" onclick="focusTimer()">--:--</div>
        <button class="timer-micro-btn" onclick="addTimeTopbar(2)">+2m</button>
        <button class="timer-micro-btn" onclick="addTimeTopbar(5)">+5m</button>
        <button class="timer-micro-btn" onclick="stopTimer()">■</button>
      </div>
      <button class="topbar-btn save-btn" onclick="saveCurrentClass()">💾 Save</button>
      <button class="topbar-btn" onclick="goHome()">⌂ Home</button>
    </div>
  </div>

  <div class="mission-layout">
    <!-- LEFT: STATS -->
    <div class="panel-stats">
      <div>
        <div class="panel-label">Mission Dashboard</div>
        <div id="stats-container">
          <div class="stat-item stat-power">
            <div class="stat-header">
              <div class="stat-name">⚡ Power</div>
              <div class="stat-value" id="stat-power-val">100%</div>
            </div>
            <div class="stat-bar-track"><div class="stat-bar-fill" id="stat-power-bar" style="width:100%"></div></div>
            <div class="stat-sublabel" id="stat-power-status">Reserves nominal</div>
          </div>
          <div class="stat-item stat-hull">
            <div class="stat-header">
              <div class="stat-name">🛡 Hull</div>
              <div class="stat-value" id="stat-hull-val">100%</div>
            </div>
            <div class="stat-bar-track"><div class="stat-bar-fill" id="stat-hull-bar" style="width:100%"></div></div>
            <div class="stat-sublabel" id="stat-hull-status">Integrity nominal</div>
          </div>
          <div class="stat-item stat-data">
            <div class="stat-header">
              <div class="stat-name">📡 Data</div>
              <div class="stat-value" id="stat-data-val">0%</div>
            </div>
            <div class="stat-bar-track"><div class="stat-bar-fill" id="stat-data-bar" style="width:0%"></div></div>
            <div class="stat-sublabel" id="stat-data-status">Awaiting collection</div>
