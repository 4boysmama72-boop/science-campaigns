<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>The Prometheus Drift — Mission Control</title>
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;700;900&family=Share+Tech+Mono&family=Rajdhani:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --bg-deep: #020812;
    --bg-panel: #060f1e;
    --bg-card: #0a1628;
    --bg-card2: #0d1d35;
    --border: #1a3a5c;
    --border-bright: #2a5a8c;
    --accent: #00c8ff;
    --accent-dim: #0080aa;
    --accent-glow: rgba(0,200,255,0.15);
    --green: #00ff88;
    --green-dim: #00aa55;
    --amber: #ffaa00;
    --red: #ff3355;
    --purple: #aa66ff;
    --text-primary: #e8f4ff;
    --text-secondary: #7aa8cc;
    --text-dim: #3a6080;
    --font-display: 'Orbitron', monospace;
    --font-mono: 'Share Tech Mono', monospace;
    --font-body: 'Rajdhani', sans-serif;
    --gaia-green: #00ff88;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: var(--bg-deep);
    color: var(--text-primary);
    font-family: var(--font-body);
    min-height: 100vh;
    overflow-x: hidden;
  }

  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image:
      radial-gradient(1px 1px at 10% 15%, rgba(255,255,255,0.6) 0%, transparent 100%),
      radial-gradient(1px 1px at 25% 40%, rgba(255,255,255,0.4) 0%, transparent 100%),
      radial-gradient(1px 1px at 50% 10%, rgba(255,255,255,0.7) 0%, transparent 100%),
      radial-gradient(1px 1px at 70% 60%, rgba(255,255,255,0.3) 0%, transparent 100%),
      radial-gradient(1px 1px at 85% 25%, rgba(255,255,255,0.5) 0%, transparent 100%),
      radial-gradient(1px 1px at 15% 75%, rgba(255,255,255,0.4) 0%, transparent 100%),
      radial-gradient(1px 1px at 40% 85%, rgba(255,255,255,0.3) 0%, transparent 100%),
      radial-gradient(1px 1px at 90% 80%, rgba(255,255,255,0.6) 0%, transparent 100%),
      radial-gradient(1px 1px at 60% 45%, rgba(255,255,255,0.2) 0%, transparent 100%),
      radial-gradient(1px 1px at 35% 55%, rgba(255,255,255,0.5) 0%, transparent 100%);
    pointer-events: none;
    z-index: 0;
  }

  body::after {
    content: '';
    position: fixed;
    inset: 0;
    background: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0,0,0,0.03) 2px, rgba(0,0,0,0.03) 4px);
    pointer-events: none;
    z-index: 1;
  }

  .app { position: relative; z-index: 2; }

  .screen { display: none; min-height: 100vh; }
  .screen.active { display: flex; flex-direction: column; }

  /* ===================== SETUP SCREEN ===================== */
  #screen-setup {
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }

  .setup-inner { width: 100%; max-width: 600px; }

  .mission-label {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--accent-dim);
    letter-spacing: .2em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .setup-title {
    font-family: var(--font-display);
    font-size: clamp(24px, 4vw, 40px);
    font-weight: 900;
    color: var(--accent);
    text-shadow: 0 0 40px rgba(0,200,255,0.4);
    letter-spacing: .05em;
    margin-bottom: 6px;
  }

  .setup-sub {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-secondary);
    margin-bottom: 2rem;
  }

  .form-group { margin-bottom: 16px; }

  .form-label {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--text-dim);
    letter-spacing: .1em;
    text-transform: uppercase;
    display: block;
    margin-bottom: 6px;
  }

  .form-input {
    background: var(--bg-card);
    border: 1px solid var(--border-bright);
    border-radius: 4px;
    padding: 10px 14px;
    color: var(--text-primary);
    font-family: var(--font-body);
    font-size: 15px;
    width: 100%;
    transition: border-color 0.2s;
  }
  .form-input:focus { outline: none; border-color: var(--accent); }

  .period-setup-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px; }

  .period-setup-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 14px;
  }

  .period-setup-label {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--accent-dim);
    letter-spacing: .1em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  /* ===================== HOME SCREEN ===================== */
  #screen-home {
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }

  .home-inner { width: 100%; max-width: 960px; }

  .mission-header { text-align: center; margin-bottom: 2.5rem; }

  .mission-title {
    font-family: var(--font-display);
    font-size: clamp(28px, 5vw, 52px);
    font-weight: 900;
    color: var(--accent);
    text-shadow: 0 0 40px rgba(0,200,255,0.5), 0 0 80px rgba(0,200,255,0.2);
    letter-spacing: .05em;
    line-height: 1.1;
    margin-bottom: 6px;
  }

  .mission-subtitle {
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--text-secondary);
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .class-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-bottom: 20px;
  }

  .class-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
    cursor: pointer;
    transition: all 0.2s;
    position: relative;
    overflow: hidden;
  }

  .class-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transition: transform 0.2s;
  }

  .class-card:hover { border-color: var(--accent-dim); background: var(--bg-card2); transform: translateY(-2px); }
  .class-card:hover::before, .class-card.selected::before { transform: scaleX(1); }
  .class-card.selected { border-color: var(--accent); background: var(--bg-card2); }

  .class-period {
    font-family: var(--font-display);
    font-size: 10px;
    font-weight: 700;
    color: var(--accent-dim);
    letter-spacing: .15em;
    text-transform: uppercase;
    margin-bottom: 6px;
  }

  .class-name {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 10px;
  }

  .class-status {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-secondary);
    margin-bottom: 6px;
  }

  .class-branch {
    font-family: var(--font-mono);
    font-size: 10px;
    padding: 2px 8px;
    border-radius: 3px;
    display: inline-block;
    margin-bottom: 10px;
  }

  .branch-nominal { background: rgba(0,255,136,0.1); color: var(--green); border: 1px solid rgba(0,255,136,0.25); }
  .branch-caution { background: rgba(255,170,0,0.1); color: var(--amber); border: 1px solid rgba(255,170,0,0.25); }
  .branch-critical { background: rgba(255,51,85,0.1); color: var(--red); border: 1px solid rgba(255,51,85,0.25); }
  .branch-new { background: rgba(0,200,255,0.08); color: var(--accent-dim); border: 1px solid rgba(0,200,255,0.2); }

  .mini-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 5px; }
  .mini-stat-label { font-family: var(--font-mono); font-size: 9px; color: var(--text-dim); text-transform: uppercase; letter-spacing: .04em; }
  .mini-stat-bar { height: 3px; background: rgba(255,255,255,0.06); border-radius: 2px; margin-top: 2px; overflow: hidden; }
  .mini-stat-fill { height: 100%; border-radius: 2px; transition: width 0.5s ease; }

  /* PENDING REVEAL BADGE */
  .reveal-badge {
    background: rgba(255,170,0,0.15);
    border: 1px solid rgba(255,170,0,0.4);
    border-radius: 4px;
    padding: 6px 10px;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--amber);
    margin-bottom: 10px;
    display: none;
  }
  .reveal-badge.visible { display: block; }

  .home-actions {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 12px;
    margin-bottom: 16px;
  }

  .btn {
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    padding: 13px 20px;
    border-radius: 4px;
    border: none;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-primary { background: var(--accent); color: var(--bg-deep); box-shadow: 0 0 20px rgba(0,200,255,0.3); }
  .btn-primary:hover { background: #33d4ff; box-shadow: 0 0 30px rgba(0,200,255,0.5); transform: translateY(-1px); }
  .btn-primary:disabled { opacity: 0.35; cursor: not-allowed; transform: none; box-shadow: none; }

  .btn-secondary { background: transparent; color: var(--accent); border: 1px solid var(--border-bright); }
  .btn-secondary:hover { border-color: var(--accent); background: var(--accent-glow); }
  .btn-secondary:disabled { opacity: 0.35; cursor: not-allowed; }

  .btn-danger { background: transparent; color: var(--red); border: 1px solid rgba(255,51,85,0.35); font-size: 10px; }
  .btn-danger:hover { background: rgba(255,51,85,0.08); border-color: var(--red); }

  .btn-amber { background: transparent; color: var(--amber); border: 1px solid rgba(255,170,0,0.35); }
  .btn-amber:hover { background: rgba(255,170,0,0.08); border-color: var(--amber); }

  .btn-green { background: var(--green); color: var(--bg-deep); box-shadow: 0 0 16px rgba(0,255,136,0.3); }
  .btn-green:hover { box-shadow: 0 0 24px rgba(0,255,136,0.5); transform: translateY(-1px); }
  .btn-green:disabled { opacity: 0.35; cursor: not-allowed; transform: none; box-shadow: none; }

  .system-time { text-align: center; font-family: var(--font-mono); font-size: 11px; color: var(--text-dim); margin-top: 8px; }

  /* ===================== MISSION SCREEN ===================== */
  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 20px;
    background: var(--bg-panel);
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
    gap: 12px;
  }

  .topbar-left { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }

  .topbar-title {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: .08em;
  }

  .topbar-tag {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--text-secondary);
    background: var(--bg-card);
    padding: 3px 10px;
    border-radius: 3px;
    border: 1px solid var(--border);
  }

  .topbar-right { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }

  .topbar-btn {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--text-secondary);
    background: var(--bg-card);
    border: 1px solid var(--border);
    padding: 5px 12px;
    border-radius: 3px;
    cursor: pointer;
    transition: all 0.15s;
    letter-spacing: .04em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .topbar-btn:hover { border-color: var(--accent-dim); color: var(--accent); }
  .topbar-btn.save-btn { color: var(--green); border-color: rgba(0,255,136,0.3); }
  .topbar-btn.save-btn:hover { background: rgba(0,255,136,0.08); }

  /* TIMER WIDGET */
  .timer-widget {
    display: flex;
    align-items: center;
    gap: 6px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 4px 10px;
  }

  .timer-readout {
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: .08em;
    min-width: 52px;
    text-align: center;
    cursor: pointer;
  }

  .timer-readout.idle { color: var(--text-dim); }
  .timer-readout.running { color: var(--green); }
  .timer-readout.low { color: var(--amber); animation: pulse-amber 1s infinite; }
  .timer-readout.urgent { color: var(--red); animation: pulse-red 0.5s infinite; }
  .timer-readout.done { color: var(--red); }

  @keyframes pulse-amber { 0%,100%{opacity:1}50%{opacity:.5} }
  @keyframes pulse-red { 0%,100%{opacity:1}50%{opacity:.4} }

  .timer-micro-btn {
    font-family: var(--font-mono);
    font-size: 10px;
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-secondary);
    padding: 2px 6px;
    border-radius: 3px;
    cursor: pointer;
    transition: all 0.15s;
    white-space: nowrap;
  }
  .timer-micro-btn:hover { border-color: var(--accent-dim); color: var(--accent); }

  /* MAIN LAYOUT */
  .mission-layout {
    display: grid;
    grid-template-columns: 260px 1fr 240px;
    flex: 1;
    overflow: hidden;
    height: calc(100vh - 53px);
  }

  /* LEFT PANEL */
  .panel-stats {
    background: var(--bg-panel);
    border-right: 1px solid var(--border);
    padding: 14px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .panel-label {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: .15em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 8px;
  }

  .stat-item { margin-bottom: 12px; }

  .stat-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 4px;
  }

  .stat-name { font-family: var(--font-body); font-size: 12px; font-weight: 600; letter-spacing: .05em; text-transform: uppercase; }
  .stat-value { font-family: var(--font-mono); font-size: 13px; font-weight: 500; }

  .stat-bar-track { height: 7px; background: rgba(255,255,255,0.05); border-radius: 4px; overflow: hidden; }

  .stat-bar-fill {
    height: 100%;
    border-radius: 4px;
    transition: width 1s cubic-bezier(0.4,0,0.2,1);
    position: relative;
  }

  .stat-bar-fill::after {
    content: '';
    position: absolute;
    top: 0; right: 0;
    width: 3px; height: 100%;
    background: rgba(255,255,255,0.35);
    border-radius: 2px;
  }

  .stat-sublabel { font-family: var(--font-mono); font-size: 9px; color: var(--text-dim); margin-top: 3px; letter-spacing: .04em; }

  /* FROZEN OVERLAY on stats when pending reveal */
  .stats-frozen { position: relative; }
  .stats-frozen::after {
    content: '⏸ PENDING REVEAL';
    position: absolute;
    inset: 0;
    background: rgba(2,8,18,0.75);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--amber);
    letter-spacing: .1em;
    border-radius: 4px;
  }

  .stat-power .stat-name { color: #00c8ff; }
  .stat-power .stat-value { color: #00c8ff; }
  .stat-power .stat-bar-fill { background: linear-gradient(90deg,#005577,#00c8ff); box-shadow: 0 0 6px rgba(0,200,255,0.4); }

  .stat-hull .stat-name { color: #00ff88; }
  .stat-hull .stat-value { color: #00ff88; }
  .stat-hull .stat-bar-fill { background: linear-gradient(90deg,#005533,#00ff88); box-shadow: 0 0 6px rgba(0,255,136,0.4); }

  .stat-data .stat-name { color: #aa66ff; }
  .stat-data .stat-value { color: #aa66ff; }
  .stat-data .stat-bar-fill { background: linear-gradient(90deg,#440066,#aa66ff); box-shadow: 0 0 6px rgba(170,102,255,0.4); }

  .stat-morale .stat-name { color: #ffaa00; }
  .stat-morale .stat-value { color: #ffaa00; }
  .stat-morale .stat-bar-fill { background: linear-gradient(90deg,#553300,#ffaa00); box-shadow: 0 0 6px rgba(255,170,0,0.4); }

  .stat-warning .stat-bar-fill { animation: flicker 2s infinite; }
  .stat-critical .stat-bar-fill { animation: flicker 0.5s infinite; }
  @keyframes flicker { 0%,100%{opacity:1}50%{opacity:.55} }

  .failure-counter { background: var(--bg-card); border: 1px solid var(--border); border-radius: 6px; padding: 10px 12px; }
  .failure-dots { display: flex; gap: 6px; margin-top: 6px; }
  .failure-dot { width: 13px; height: 13px; border-radius: 50%; border: 1px solid var(--border); background: transparent; transition: all 0.3s; }
  .failure-dot.active { background: var(--red); border-color: var(--red); box-shadow: 0 0 6px rgba(255,51,85,0.6); }
  .restriction-notice { font-family: var(--font-mono); font-size: 10px; color: var(--amber); margin-top: 6px; line-height: 1.5; }

  .log-entry { background: var(--bg-card); border: 1px solid var(--border); border-radius: 4px; padding: 7px 9px; margin-bottom: 5px; }
  .log-date { font-family: var(--font-mono); font-size: 9px; color: var(--text-dim); margin-bottom: 2px; }
  .log-choice { font-family: var(--font-mono); font-size: 10px; color: var(--text-secondary); line-height: 1.4; margin-bottom: 4px; }
  .log-impact { display: flex; gap: 3px; flex-wrap: wrap; }
  .impact-tag { font-size: 9px; padding: 1px 5px; border-radius: 2px; font-weight: 500; }
  .impact-pos { background: rgba(0,255,136,0.12); color: var(--green); }
  .impact-neg { background: rgba(255,51,85,0.12); color: var(--red); }
  .impact-neu { background: rgba(255,255,255,0.05); color: var(--text-dim); }

  /* CENTER PANEL */
  .panel-story { display: flex; flex-direction: column; overflow: hidden; }

  .story-content { flex: 1; overflow-y: auto; padding: 22px 26px; }

  .act-label {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--accent-dim);
    letter-spacing: .15em;
    text-transform: uppercase;
    margin-bottom: 4px;
  }

  .act-title {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: .04em;
    margin-bottom: 10px;
    line-height: 1.2;
  }

  .act-divider { height: 1px; background: linear-gradient(90deg,var(--accent-dim),transparent); margin-bottom: 20px; }

  /* PHASE INDICATOR */
  .phase-bar {
    display: flex;
    gap: 4px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .phase-step {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: .06em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 3px;
    border: 1px solid var(--border);
    color: var(--text-dim);
    background: transparent;
    cursor: pointer;
    transition: all 0.2s;
    white-space: nowrap;
  }

  .phase-step.active { color: var(--accent); border-color: var(--accent-dim); background: var(--accent-glow); }
  .phase-step.done { color: var(--green-dim); border-color: rgba(0,255,136,0.2); background: rgba(0,255,136,0.05); }
  .phase-step:hover:not(.active):not(.done) { border-color: var(--border-bright); color: var(--text-secondary); }

  /* GAIA BOX */
  .gaia-box {
    background: var(--bg-card);
    border: 1px solid rgba(0,255,136,0.2);
    border-left: 3px solid var(--gaia-green);
    border-radius: 6px;
    padding: 14px 16px;
    margin-bottom: 18px;
  }

  .gaia-header { display: flex; align-items: center; gap: 8px; margin-bottom: 10px; }

  .gaia-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--gaia-green);
    box-shadow: 0 0 8px rgba(0,255,136,0.8);
    animation: gaia-pulse 2s infinite;
    flex-shrink: 0;
  }

  @keyframes gaia-pulse { 0%,100%{opacity:1}50%{opacity:.35} }

  .gaia-label { font-family: var(--font-mono); font-size: 10px; color: var(--gaia-green); letter-spacing: .1em; text-transform: uppercase; }

  .gaia-text { font-family: var(--font-body); font-size: 16px; color: var(--text-primary); line-height: 1.7; }
  .gaia-text em { color: var(--gaia-green); font-style: italic; }

  .scenario-text { font-family: var(--font-body); font-size: 16px; color: var(--text-secondary); line-height: 1.75; margin-bottom: 20px; }

  /* PHASE CONTENT PANELS */
  .phase-panel { display: none; }
  .phase-panel.active { display: block; }

  /* TIMER PHASE PANEL */
  .timer-phase-box {
    background: var(--bg-card);
    border: 1px solid var(--border-bright);
    border-radius: 8px;
    padding: 20px 22px;
    margin-bottom: 18px;
    text-align: center;
  }

  .timer-phase-title {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 6px;
  }

  .timer-phase-desc {
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 16px;
  }

  .big-timer {
    font-family: var(--font-display);
    font-size: 52px;
    font-weight: 900;
    letter-spacing: .05em;
    margin-bottom: 14px;
    transition: color 0.3s;
  }

  .big-timer.idle { color: var(--text-dim); }
